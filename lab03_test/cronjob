# IW03 — задачи cron для currency_exchange_rate.py
#
# Формат строки:  мин  час  день_мес  месяц  день_недели  команда
# (день недели: 0 и 7 — воскресенье, 5 — пятница)
#
# ВАЖНО: символ '%' в crontab имеет специальное значение и
# обязательно экранируется обратным слэшем: \%
#
# Вывод задач (stdout и stderr) пишется в /var/log/cron.log.

# Курс MDL -> EUR за предыдущий день — ежедневно в 06:00
0 6 * * * /usr/local/bin/python3 /app/currency_exchange_rate.py MDL EUR $(date -d "yesterday" +\%F) --allow-any-date --api-url "$API_URL" >> /var/log/cron.log 2>&1

# Курс MDL -> USD за предыдущую неделю — каждую пятницу в 17:00
0 17 * * 5 /usr/local/bin/python3 /app/currency_exchange_rate.py MDL USD $(date -d "1 week ago" +\%F) --allow-any-date --api-url "$API_URL" >> /var/log/cron.log 2>&1

