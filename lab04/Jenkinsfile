pipeline {
    agent {
        label 'php-agent'
    }

    stages {
        stage('Install Dependencies') {
            steps {
                // Подготовка проекта (установка зависимостей, если необходимо)
                echo 'Подготовка проекта...'
                // Проект php-app написан на чистом PHP и не использует Composer,
                // поэтому достаточно проверить наличие интерпретатора php-cli
                sh 'php -v'
            }
        }

        stage('Test') {
            steps {
                // Запуск тестов
                echo 'Запуск тестов...'
                // Модульные тесты php-app (Calculator, StrUtils).
                // Скрипт возвращает ненулевой код возврата при провале,
                // что автоматически помечает сборку как неуспешную.
                sh 'php lab04/php-app/tests/run_tests.php'
            }
        }
    }

    post {
        always {
            echo 'Конвейер завершен.'
        }
        success {
            echo 'Все этапы прошли успешно!'
        }
        failure {
            echo 'Обнаружены ошибки в конвейере.'
        }
    }
}
